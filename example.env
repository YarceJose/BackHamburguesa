# Copy this file to .env and change the values

# --- Postgres ---
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Host port of the Docker Postgres (used by `dotnet run`)
DB_HOST_PORT=5433
DB_NAME=hamburguesa

# --- JWT (min 32 characters). Generate one with: openssl rand -base64 48 ---
JWT_KEY=change-me-to-a-long-key-of-at-least-32-characters
# Max session length; kitchen/delivery sessions also end on "Cerrar jornada"
JWT_EXPIRATION_MINUTES=1440

# --- Front-Hamburguesa (origin allowed by CORS) ---
FRONT_URL=http://localhost:5173

# --- Initial admin (created only when no Admin exists) ---
ADMIN_FULLNAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hamburguesa.local
ADMIN_PASSWORD=change-me

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me
# Key n8n sends in the X-Api-Key header. Generate one with: openssl rand -hex 32
N8N_API_KEY=change-me
# n8n webhook that receives order events (default: the bundled workflow)
N8N_ORDERS_WEBHOOK_URL=http://n8n:5678/webhook/pedidos

# --- WhatsApp Business Cloud API (Meta), used by the n8n workflow ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Staff phone that receives alerts, with country code, e.g. 573001234567
WHATSAPP_STAFF_NUMBER=
