# Copia este archivo como .env y cambia los valores

# --- Postgres ---
DB_USER=postgres
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432
# Puerto del Postgres de Docker en tu máquina (para dotnet run)
DB_HOST_PORT=5433
DB_NAME=hamburguesa
DB_Test=hamburguesa_test

# --- JWT (mínimo 32 caracteres). Genera uno con: openssl rand -base64 48 ---
JWT_KEY=cambia-esto-por-una-clave-larga-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=480

# --- Front-Hamburguesa (origen permitido por CORS) ---
FRONT_URL=http://localhost:5173

# --- Admin inicial (se crea solo si no existe ningún Admin) ---
ADMIN_FULLNAME=Administrador
ADMIN_EMAIL=admin@hamburguesa.local
ADMIN_PASSWORD=cambia-esto

# --- n8n ---
N8N_ENCRYPTION_KEY=cambia-esto
# Clave que n8n envía en la cabecera X-Api-Key. Genera una con: openssl rand -hex 32
N8N_API_KEY=cambia-esto
